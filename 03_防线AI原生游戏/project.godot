; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="防线 DefenseLine"
config/description="腾讯AI原生游戏开发比赛 · 心理叙事探索游戏《防线》"
config/version="0.1.0"
run/main_scene="res://scenes/classroom.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/EventBus.gd"
SceneManager="*res://scripts/scene_manager.gd"
DialogManager="*res://scripts/dialog_manager.gd"
DialogueHistory="*res://scripts/dialogue_history.gd"
ChatUI="*res://scripts/chat_ui.gd"
VisualNovelUI="*res://scripts/visual_novel_ui.gd"
FriendEncounters="*res://scripts/friend_encounters.gd"
MemoryAnchorUI="*res://scripts/memory_anchor_ui.gd"
TrustDrift="*res://scripts/trust_drift_collector.gd"
AmbientDirector="*res://scripts/ambient_director.gd"
LLMGateway="*res://scripts/llm_gateway.gd"
MemoryArchaeology="*res://scripts/memory_archaeology.gd"
ArchaeologyTrigger="*res://scripts/archaeology_trigger.gd"
ArchaeologyUI="*res://scripts/archaeology_ui.gd"
BattleChoiceUI="*res://scripts/battle_choice_ui.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
